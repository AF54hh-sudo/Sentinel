SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_RANDOM_SEED=42
SENTINEL_DATA_DIR=data/generated
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:change-me@localhost:5432/sentinel_db
SENTINEL_LLM_PROVIDER=openai
SENTINEL_LLM_MODEL=gpt-5.4-nano
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_TIMEOUT_SECONDS=30
SENTINEL_LLM_MAX_RETRIES=2
SENTINEL_EMBEDDING_PROVIDER=openai
SENTINEL_EMBEDDING_MODEL=text-embedding-3-small
SENTINEL_EMBEDDING_DIMENSIONS=1536
SENTINEL_EMBEDDING_BATCH_SIZE=64
SENTINEL_DOCUMENTS_DIR=data/documents
SENTINEL_RAG_TOP_K=5
SENTINEL_RAG_MIN_SIMILARITY=0.0
